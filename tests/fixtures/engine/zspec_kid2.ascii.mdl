# nwn-mdl-spec conformance probe zspec_kid2 (CC0-1.0)
# A second model on the supermodel zspec_super: 'hand' under 'Arm' (the
# supermodel's second 'hand'; 'Arm' differs from 'arm' only in case) and
# 'foot' directly under the root (in the supermodel it is under 'hips').
# Tells a name walk down the tree from a global name lookup.
newmodel zspec_kid2
setsupermodel zspec_kid2 zspec_super
classification character
beginmodelgeom zspec_kid2
node dummy zspec_kid2
  parent NULL
endnode
node dummy hips
  parent zspec_kid2
endnode
node dummy Arm
  parent hips
endnode
node dummy hand
  parent Arm
endnode
node dummy foot
  parent zspec_kid2
endnode
endmodelgeom zspec_kid2
donemodel zspec_kid2
