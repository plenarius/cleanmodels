# mdl-spec conformance probe zspec_setfill (CC0-1.0)
# The misspelt 'setfillumcolor' keyword (common in old exports), alone on
# one mesh, next to a mesh with 'selfillumcolor'. Does the engine read the
# misspelling?
newmodel zspec_setfill
setsupermodel zspec_setfill NULL
classification character
beginmodelgeom zspec_setfill
node dummy zspec_setfill
  parent NULL
endnode
node trimesh typo
  parent zspec_setfill
  bitmap zspec_t0
  setfillumcolor 1 0.5 0.25
  verts 3
    0 0 0
    1 0 0
    0 1 0
  tverts 3
    0 0 0
    1 0 0
    0 1 0
  faces 1
    0 1 2 1 0 1 2 0
endnode
node trimesh right
  parent zspec_setfill
  bitmap zspec_t0
  selfillumcolor 1 0.5 0.25
  verts 3
    0 0 1
    1 0 1
    0 1 1
  tverts 3
    0 0 0
    1 0 0
    0 1 0
  faces 1
    0 1 2 1 0 1 2 0
endnode
endmodelgeom zspec_setfill
donemodel zspec_setfill
