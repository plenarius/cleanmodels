# mdl-spec conformance probe zspec_animfx (CC0-1.0)
# Linear keys on a light (colour, radius, multiplier, shadowradius,
# verticaldisplacement) and an emitter (birthrate, colorStart, alphaEnd,
# sizeStart_y, percentMid, detonate with time-only rows), plus
# lightningsubdivkey, which the engine's parser may not know.
newmodel zspec_animfx
setsupermodel zspec_animfx NULL
classification effect
beginmodelgeom zspec_animfx
node dummy zspec_animfx
  parent NULL
endnode
node light lamp
  parent zspec_animfx
  color 1 1 1
  radius 5
  multiplier 1
endnode
node emitter fx
  parent zspec_animfx
  update Explosion
  render Normal
  blend Normal
  texture fxpa_flare
  birthrate 10
  lifeExp 1
endnode
endmodelgeom zspec_animfx
newanim impact zspec_animfx
  length 1
  transtime 0
  animroot zspec_animfx
  node dummy zspec_animfx
    parent NULL
  endnode
  node light lamp
    parent zspec_animfx
    colorkey 2
      0 1 0 0
      1 0 0 1
    radiuskey 2
      0 5
      1 10
    multiplierkey 2
      0 1
      1 2
    shadowradiuskey 2
      0 3
      1 6
    verticaldisplacementkey 2
      0 0
      1 0.5
  endnode
  node emitter fx
    parent zspec_animfx
    birthratekey 2
      0 10
      1 20
    colorStartkey 2
      0 1 1 1
      1 1 0 0
    alphaEndkey 2
      0 0
      1 0.5
    sizeStart_ykey 2
      0 1
      1 2
    percentMidkey 2
      0 0.25
      1 0.75
    detonatekey 2
      0.25
      0.75
    lightningsubdivkey 2
      0 1
      1 2
  endnode
doneanim impact zspec_animfx
donemodel zspec_animfx
