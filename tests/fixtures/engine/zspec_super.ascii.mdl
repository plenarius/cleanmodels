# nwn-mdl-spec conformance probe zspec_super (CC0-1.0)
# A supermodel for zspec_kid. The name 'hand' is used twice (under hips
# and under arm). It has one animation.
newmodel zspec_super
setsupermodel zspec_super NULL
classification character
beginmodelgeom zspec_super
node dummy zspec_super
  parent NULL
endnode
node dummy hips
  parent zspec_super
  position 0 0 1
endnode
node dummy hand
  parent hips
  position 0.5 0 0
endnode
node dummy arm
  parent hips
  position -0.5 0 0
endnode
node dummy hand
  parent arm
  position -0.25 0 0
endnode
node dummy foot
  parent hips
  position 0 0 -1
endnode
endmodelgeom zspec_super
newanim superanim zspec_super
  length 1
  transtime 0
  animroot zspec_super
  node dummy zspec_super
    parent NULL
  endnode
  node dummy hips
    parent zspec_super
    positionkey 2
      0 0 0 1
      1 0 0 1.5
  endnode
doneanim superanim zspec_super
donemodel zspec_super
